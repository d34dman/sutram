{
  "name": "@d34dman/sutram",
  "version": "0.2.0",
  "description": "A standard way for JavaScript apps to expose their commands: to people in a console, and to AI agents through WebMCP.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./events": "./src/events.js",
    "./webmcp": "./src/webmcp.js",
    "./console": "./src/console.js",
    "./browser": "./src/browser.js",
    "./package.json": "./package.json",
    "./dist/sutram.js": "./dist/sutram.js"
  },
  "files": [
    "src",
    "dist",
    "docs"
  ],
  "sideEffects": [
    "./src/browser.js"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "example": "node example/serve.js"
  },
  "keywords": [
    "command-palette",
    "console",
    "webmcp",
    "mcp",
    "ai-agents",
    "drupal"
  ],
  "author": "Shibin Das (https://www.drupal.org/u/d34dman)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d34dman/sutram.git"
  },
  "homepage": "https://github.com/d34dman/sutram#readme",
  "bugs": {
    "url": "https://github.com/d34dman/sutram/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
