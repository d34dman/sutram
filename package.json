{
  "name": "@d34dman/sutram",
  "version": "0.8.1",
  "description": "One set of commands for your web app: people type them in a console, AI agents call them as WebMCP tools or from JavaScript. Every part of the app registers its commands the same way, and they run in the user's own session.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "default": "./src/client.js"
    },
    "./internals": {
      "types": "./types/internals.d.ts",
      "default": "./src/internals.js"
    },
    "./events": {
      "types": "./types/events.d.ts",
      "default": "./src/events.js"
    },
    "./webmcp": {
      "types": "./types/webmcp.d.ts",
      "default": "./src/webmcp.js"
    },
    "./console": {
      "types": "./types/console.d.ts",
      "default": "./src/console.js"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./nav": {
      "types": "./types/nav.d.ts",
      "default": "./src/nav.js"
    },
    "./page": {
      "types": "./types/page.d.ts",
      "default": "./src/page.js"
    },
    "./user": {
      "types": "./types/user.d.ts",
      "default": "./src/user.js"
    },
    "./messages": {
      "types": "./types/messages.d.ts",
      "default": "./src/messages.js"
    },
    "./lists": {
      "types": "./types/lists.d.ts",
      "default": "./src/lists.js"
    },
    "./forms": {
      "types": "./types/forms.d.ts",
      "default": "./src/forms.js"
    },
    "./package.json": "./package.json",
    "./dist/sutram.js": {
      "types": "./types/dist.d.ts",
      "default": "./dist/sutram.js"
    },
    "./dist/sutram.min.js": {
      "types": "./types/dist.d.ts",
      "default": "./dist/sutram.min.js"
    },
    "./dist/nav.js": {
      "types": "./types/nav.d.ts",
      "default": "./dist/nav.js"
    },
    "./dist/page.js": {
      "types": "./types/page.d.ts",
      "default": "./dist/page.js"
    },
    "./dist/user.js": {
      "types": "./types/user.d.ts",
      "default": "./dist/user.js"
    },
    "./dist/messages.js": {
      "types": "./types/messages.d.ts",
      "default": "./dist/messages.js"
    },
    "./dist/lists.js": {
      "types": "./types/lists.d.ts",
      "default": "./dist/lists.js"
    },
    "./dist/forms.js": {
      "types": "./types/forms.d.ts",
      "default": "./dist/forms.js"
    },
    "./skins/*": "./skins/*"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-GPL-2.0",
    "LICENSE-MIT",
    "dist",
    "skins",
    "docs",
    "!docs/design.md",
    "!docs/measurements",
    "skills",
    "src",
    "types"
  ],
  "sideEffects": [
    "./src/browser.js",
    "./dist/sutram.js",
    "./dist/sutram.min.js",
    "./dist/nav.js",
    "./dist/nav.min.js",
    "./dist/page.js",
    "./dist/page.min.js",
    "./dist/user.js",
    "./dist/user.min.js",
    "./dist/messages.js",
    "./dist/messages.min.js",
    "./dist/lists.js",
    "./dist/lists.min.js",
    "./dist/forms.js",
    "./dist/forms.min.js"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "example": "node example/serve.js",
    "docs": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "measure": "node scripts/measure.mjs",
    "site": "node scripts/build.mjs && cp dist/sutram.js site/sutram.js && node scripts/docs.mjs --site && node example/serve.js site"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agentic-ai",
    "llm-tools",
    "command-line",
    "command-palette",
    "console",
    "repl",
    "web-components",
    "json-schema",
    "browser",
    "developer-tools",
    "drupal"
  ],
  "author": "Shibin Das (https://www.drupal.org/u/d34dman)",
  "license": "(MIT OR GPL-2.0-or-later)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d34dman/sutram.git"
  },
  "homepage": "https://d34dman.github.io/sutram/docs/index.html",
  "bugs": {
    "url": "https://github.com/d34dman/sutram/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "./types/index.d.ts"
}
