{
  "name": "@d34dman/sutram",
  "version": "0.3.0",
  "description": "Let AI agents use your web app through commands, not clicks. Register commands once: agents call them through WebMCP, from JavaScript in a headless browser, or by typing into a console that people can use too.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./events": "./src/events.js",
    "./webmcp": "./src/webmcp.js",
    "./console": "./src/console.js",
    "./browser": "./src/browser.js",
    "./package.json": "./package.json",
    "./dist/sutram.js": "./dist/sutram.js"
  },
  "files": [
    "LICENSE",
    "LICENSE-GPL-2.0",
    "LICENSE-MIT",
    "dist",
    "docs",
    "src"
  ],
  "sideEffects": [
    "./src/browser.js"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "example": "node example/serve.js",
    "site": "node scripts/build.mjs && cp dist/sutram.js site/sutram.js && node example/serve.js site"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agentic-ai",
    "llm-tools",
    "command-line",
    "command-palette",
    "console",
    "repl",
    "web-components",
    "json-schema",
    "browser",
    "developer-tools",
    "drupal"
  ],
  "author": "Shibin Das (https://www.drupal.org/u/d34dman)",
  "license": "(MIT OR GPL-2.0-or-later)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d34dman/sutram.git"
  },
  "homepage": "https://github.com/d34dman/sutram#readme",
  "bugs": {
    "url": "https://github.com/d34dman/sutram/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
